[Unit]
Description=C_ROBOT restore emptied Wi-Fi profiles before NetworkManager starts
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/caconee/c_robot/scripts/pi_netfix.py restore

[Install]
WantedBy=NetworkManager.service
